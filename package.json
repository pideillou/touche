{
  "name": "touche",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android": "npx eas-cli@latest build --profile development --platform android",
    "build:ios": "npx eas-cli@latest build --profile development --platform ios",
    "apk": "npx eas-cli@latest build --profile preview --platform android",
    "variables:eas": "node scripts/variables-eas.js",
    "web": "expo export --platform web --output-dir dist-web && node scripts/publier-pwa.js",
    "web:local": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "maplibre-gl": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
